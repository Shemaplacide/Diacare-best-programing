# Copy to .env for local development. Never commit .env or real secrets.

# Local PostgreSQL (docker-compose)
POSTGRES_DB=diacare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Backend database. On Neon use the JDBC form with TLS, for example:
# jdbc:postgresql://<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channelBinding=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/diacare
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
# Optional: connection pool size (5 is enough on Neon Free)
DB_POOL_SIZE=10

# Optional: the host's port. Render sets PORT itself; locally the API uses 8085.
# PORT=8085

# Comma-separated browser origins allowed to call the API (no trailing slash)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional mail settings (not used by any feature yet)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT signing secret: at least 32 random characters
JWT_SECRET=change-this-secret-for-local-development-32+chars
JWT_EXPIRATION_MS=86400000

# Demo data seeded into an empty database. Set private passwords on hosted demos.
DEMO_SEED_ENABLED=true
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_DOCTOR_PASSWORD=Doctor@123
DEMO_PATIENT_PASSWORD=Patient@123

# Frontend: API base URL including /api/v1
VITE_API_URL=http://localhost:8085/api/v1
